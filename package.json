{
  "name": "trade-imports-defra-id-stub",
  "version": "0.0.0",
  "description": "CDP Frontend Template",
  "sideEffects": false,
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build:frontend": "NODE_ENV=production webpack",
    "dev": "npm run frontend:watch & npm run server:watch wait",
    "dev:debug": "npm run frontend:watch & server:debug wait",
    "frontend:watch": "NODE_ENV=development webpack --watch",
    "git:pre-commit-hook": "npm run lint:fix",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "postinstall": "npm run setup:husky",
    "postversion": "git add package.json package-lock.json && git commit -m $npm_package_version",
    "server:debug": "nodemon --inspect-brk=0.0.0.0 --ext js --legacy-watch ./src",
    "server:watch": "nodemon --inspect=0.0.0.0 --ext js --legacy-watch ./src",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "start": "NODE_ENV=production node --use-strict .",
    "test": "TZ=UTC vitest run --coverage",
    "test:watch": "TZ=UTC vitest",
    "security-audit": "audit-ci --config audit-ci.jsonc"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@defra/hapi-tracing": "^1.30.1",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/bell": "^13.2.0",
    "@hapi/catbox-redis": "^7.1.0",
    "@hapi/cookie": "12.0.1",
    "@hapi/hapi": "21.4.10",
    "@hapi/inert": "^7.1.2",
    "@hapi/jwt": "^3.2.4",
    "@hapi/scooter": "^8.0.0",
    "@hapi/vision": "7.0.3",
    "@hapi/wreck": "^18.1.2",
    "@hapi/yar": "11.0.3",
    "aws-embedded-metrics": "^4.2.1",
    "blankie": "5.0.0",
    "convict": "^6.2.5",
    "convict-format-with-validator": "6.2.0",
    "cssnano": "9.3.2",
    "cssnano-preset-default": "9.3.2",
    "date-fns": "^4.4.0",
    "global-agent": "3.0.0",
    "govuk-frontend": "6.3.0",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "4.0.0",
    "ioredis": "5.9.2",
    "joi": "18.2.9",
    "jwk-to-pem": "2.0.7",
    "node-fetch": "3.3.2",
    "nunjucks": "3.2.4",
    "pino": "9.7.0",
    "pino-pretty": "^13.2.0",
    "semver": "^7.8.5",
    "undici": "7.30.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.3",
    "audit-ci": "7.1.0",
    "autoprefixer": "^10.6.1",
    "clean-webpack-plugin": "4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "neostandard": "0.14.0-next.1",
    "nodemon": "^3.1.14",
    "postcss-load-config": "6.0.1",
    "postcss-loader": "^8.2.1",
    "sass": "^1.105.1",
    "sass-loader": "17.0.1",
    "source-map-loader": "5.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "testcontainers": "^12.2.0",
    "vitest": "5.0.3",
    "vitest-fetch-mock": "0.4.5",
    "webpack": "^5.111.1",
    "webpack-assets-manifest": "^6.5.4",
    "webpack-cli": "7.2.3"
  }
}
